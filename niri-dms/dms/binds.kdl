binds {

    // --- Settings ---
    Mod+F1                              { show-hotkey-overlay; }
    // OLD (replaced by standardized settings shortcut): Mod+Comma                           hotkey-overlay-title="Settings" {
    // OLD (replaced by standardized settings shortcut): spawn "dms" "ipc" "call" "settings" "focusOrToggle";
    // OLD (replaced by standardized settings shortcut): }
    Mod+Shift+W                         hotkey-overlay-title="Create window rule" { spawn "dms" "ipc" "call" "window-rules" "toggle"; }
    Mod+H                               hotkey-overlay-title="Settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+Period                          hotkey-overlay-title="Edit Niri config" { spawn-sh "alacritty -e nvim \"$HOME/.config/niri-dms\""; }

    // --- Apps ---
    Alt+Return                          hotkey-overlay-title="Terminal: Alacritty" { spawn "alacritty"; }
    Mod+Return                          hotkey-overlay-title="Terminal: Alacritty" { spawn "alacritty"; }
    Alt+W                               hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+W                               hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Alt+E                               hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }
    Mod+E                               hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }
    Alt+D                               hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+D                               hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Alt+M                               hotkey-overlay-title="Toggle monitor resolution" { spawn-sh "$HOME/.local/bin/mon --niri"; }
    Mod+M                               hotkey-overlay-title="Toggle monitor resolution" { spawn-sh "$HOME/.local/bin/mon --niri"; }
    Alt+Space                           hotkey-overlay-title="Spotlight Bar" {
        spawn "dms" "ipc" "call" "spotlight-bar" "toggle";
    }
    Mod+N                               hotkey-overlay-title="Notification Center" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+N                         hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    XF86AudioRaiseVolume                allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "increment" "3";
    }
    XF86AudioLowerVolume                allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "decrement" "3";
    }
    XF86AudioMute                       allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "mute";
    }
    Mod+Q                               repeat=false { close-window; }
    Mod+F                               { maximize-column; }
    Mod+Shift+F                         { fullscreen-window; }
    // OLD (key reassigned to Ctrl+Shift+R): Ctrl+Shift+R                        hotkey-overlay-title="Rename Workspace" {
    // OLD (key reassigned to Ctrl+Shift+R): spawn "dms" "ipc" "call" "workspace-rename" "open";
    // OLD (key reassigned to Ctrl+Shift+R): }
    Mod+Ctrl+C                          { center-visible-columns; }

    // --- Resize / Swap ---
    // OLD (replaced by standardized float shortcut): Mod+Shift+T                         { toggle-window-floating; }
    // OLD (replaced by standardized column-width controls): Mod+R                               { switch-preset-column-width; }
    Mod+Shift+R                         { switch-preset-window-height; }
    Mod+Ctrl+R                          { reset-window-height; }
    Mod+Ctrl+F                          { expand-column-to-available-width; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }
    Mod+T                               { toggle-window-floating; }
    Mod+Backspace                       { switch-preset-column-width-back; }

    // --- Focus ---
    //Mod+Ctrl+Down  { focus-monitor-down; }
    //Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Tab                             repeat=false { toggle-overview; }
    // OLD (replaced by standardized overview shortcut): Mod+Backspace                       { toggle-overview; }
    Mod+Shift+V                         { switch-focus-between-floating-and-tiling; }
    Mod+Left                            { focus-column-left; }
    Mod+Down                            { focus-window-down; }
    Mod+Up                              { focus-window-up; }
    Mod+Right                           { focus-column-right; }
    // OLD (replaced by arrow focus controls): Mod+H                               { focus-column-left; }
    Mod+J                               { focus-window-down; }
    Mod+K                               { focus-window-up; }
    // OLD (replaced by arrow focus controls): Mod+L                               { focus-column-right; }
    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    // OLD (monitor binding disabled per request): Mod+Ctrl+Left                       { focus-monitor-left; }
    // OLD (monitor binding disabled per request): Mod+Ctrl+Right                      { focus-monitor-right; }
    // OLD (monitor binding disabled per request): Mod+Ctrl+H                          { focus-monitor-left; }
    // OLD (monitor binding disabled per request): Mod+Ctrl+J                          { focus-monitor-down; }
    // OLD (monitor binding disabled per request): Mod+Ctrl+K                          { focus-monitor-up; }
    // OLD (monitor binding disabled per request): Mod+Ctrl+L                          { focus-monitor-right; }
    Mod+Page_Down                       { focus-workspace-down; }
    Mod+Page_Up                         { focus-workspace-up; }
    Mod+U                               { focus-workspace-down; }
    Mod+I                               { focus-workspace-up; }

    // --- Movement ---
    Mod+Shift+Left                      { move-column-left; }
    Mod+Shift+Down                      { move-window-down; }
    Mod+Shift+Up                        { move-window-up; }
    Mod+Shift+Right                     { move-column-right; }
    // OLD (replaced by arrow movement controls): Mod+Shift+H                         { move-column-left; }
    Mod+Shift+J                         { move-window-down; }
    Mod+Shift+K                         { move-window-up; }
    // OLD (replaced by arrow movement controls): Mod+Shift+L                         { move-column-right; }
    Mod+Ctrl+Home                       { move-column-to-first; }
    Mod+Ctrl+End                        { move-column-to-last; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+Left                 { move-column-to-monitor-left; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+Down                 { move-column-to-monitor-down; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+Up                   { move-column-to-monitor-up; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+Right                { move-column-to-monitor-right; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+H                    { move-column-to-monitor-left; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+J                    { move-column-to-monitor-down; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+K                    { move-column-to-monitor-up; }
    // OLD (monitor binding disabled per request): Mod+Shift+Ctrl+L                    { move-column-to-monitor-right; }
    Mod+Ctrl+Down                       { move-column-to-workspace-down; }
    Mod+Ctrl+Up                         { move-column-to-workspace-up; }
    Mod+Ctrl+U                          { move-column-to-workspace-down; }
    Mod+Ctrl+I                          { move-column-to-workspace-up; }

    // --- Column ---
    Mod+Ctrl+W                          { toggle-column-tabbed-display; }
    Mod+BracketLeft                     { consume-or-expel-window-left; }
    Mod+BracketRight                    { consume-or-expel-window-right; }
    // OLD (key reassigned to Mod+Period): Mod+Period                          { expel-window-from-column; }
    Mod+C                               { center-column; }

    // --- Workspaces ---
    Mod+Shift+Page_Down                 { move-workspace-down; }
    Mod+Shift+Page_Up                   { move-workspace-up; }
    Mod+Shift+U                         { move-workspace-down; }
    Mod+Shift+I                         { move-workspace-up; }
    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }
    Mod+Shift+1                         { move-column-to-workspace 1; }
    Mod+Shift+2                         { move-column-to-workspace 2; }
    Mod+Shift+3                         { move-column-to-workspace 3; }
    Mod+Shift+4                         { move-column-to-workspace 4; }
    Mod+Shift+5                         { move-column-to-workspace 5; }
    Mod+Shift+6                         { move-column-to-workspace 6; }
    Mod+Shift+7                         { move-column-to-workspace 7; }
    Mod+Shift+8                         { move-column-to-workspace 8; }
    Mod+Shift+9                         { move-column-to-workspace 9; }
    Mod+0                               { focus-workspace 10; }
    Mod+Shift+0                         { move-column-to-workspace 10; }

    // --- Lock / session / task controls ---
    // OLD (replaced by standardized task shortcut): Mod+Shift+M                         hotkey-overlay-title="Task Manager" {
    // OLD (replaced by standardized task shortcut): spawn "dms" "ipc" "call" "processlist" "focusOrToggle";
    // OLD (replaced by standardized task shortcut): }
    Alt+X                               hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+X                               hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    // OLD (replaced by standardized lock shortcut): Mod+Alt+L                           hotkey-overlay-title="Lock Screen" {
    // OLD (replaced by standardized lock shortcut): spawn "dms" "ipc" "call" "lock" "lock";
    // OLD (replaced by standardized lock shortcut): }
    // OLD (replaced by standardized quit shortcut): Mod+Shift+E                         { quit; }
    // OLD (replaced by standardized task shortcut): Ctrl+Alt+Delete                     hotkey-overlay-title="Task Manager" {
    // OLD (replaced by standardized task shortcut): spawn "dms" "ipc" "call" "processlist" "focusOrToggle";
    // OLD (replaced by standardized task shortcut): }
    Mod+Escape                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Alt+T                           hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Mod+Shift+L                         hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Ctrl+Shift+R                        hotkey-overlay-title="Restart DMS" { spawn "dms" "restart"; }
    Ctrl+Alt+Delete                     hotkey-overlay-title="Logout to SDDM" { quit; }

    // --- Audio / media ---
    Mod+V                               hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }
    XF86AudioMicMute                    allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "micmute";
    }
    XF86AudioPause                      allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "playPause";
    }
    XF86AudioPlay                       allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "playPause";
    }
    XF86AudioPrev                       allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "previous";
    }
    XF86AudioNext                       allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "next";
    }
    Ctrl+XF86AudioRaiseVolume           allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "increment" "3";
    }
    Ctrl+XF86AudioLowerVolume           allow-when-locked=true {
        spawn "dms" "ipc" "call" "mpris" "decrement" "3";
    }

    // --- Display ---
    // OLD (replaced by standardized wallpaper shortcut): Mod+Y                               hotkey-overlay-title="Browse Wallpapers" {
    // OLD (replaced by standardized wallpaper shortcut): spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper";
    // OLD (replaced by standardized wallpaper shortcut): }
    XF86MonBrightnessUp                 allow-when-locked=true {
       spawn "dms" "ipc" "call" "brightness" "increment" "5" "";
    }
    XF86MonBrightnessDown               allow-when-locked=true {
       spawn "dms" "ipc" "call" "brightness" "decrement" "5" "";
    }
    // OLD (replaced by standardized screenshot shortcut): XF86Launch1                         hotkey-overlay-title="Screenshot: Region" { spawn "dms" "screenshot"; }
    // OLD (replaced by standardized screenshot shortcut): Ctrl+XF86Launch1                    hotkey-overlay-title="Screenshot: Full Screen" { spawn "dms" "screenshot" "full"; }
    // OLD (replaced by standardized screenshot shortcut): Alt+XF86Launch1                     hotkey-overlay-title="Screenshot: Window" { spawn "dms" "screenshot" "window"; }
    // OLD (replaced by standardized screenshot shortcut): Print                               hotkey-overlay-title="Screenshot: Region" { spawn "dms" "screenshot"; }
    // OLD (replaced by standardized screenshot shortcut): Ctrl+Print                          hotkey-overlay-title="Screenshot: Full Screen" { spawn "dms" "screenshot" "full"; }
    // OLD (replaced by standardized screenshot shortcut): Alt+Print                           hotkey-overlay-title="Screenshot: Window" { spawn "dms" "screenshot" "window"; }
    Mod+P                               hotkey-overlay-title="Cycle Display Profile" {
        spawn "dms" "ipc" "outputs" "cycleProfile";
    }
    Mod+Shift+P                         { power-off-monitors; }
    Mod+F10                             hotkey-overlay-title="Wallpapers" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Alt+F10                             hotkey-overlay-title="Wallpapers" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Print                               { screenshot; }
    Ctrl+Print                          { screenshot-screen; }
    Alt+Print                           { screenshot-window; }

    // --- Mouse ---
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }
    // OLD (replaced by arrow focus controls): Mod+WheelScrollRight                { focus-column-right; }
    // OLD (replaced by arrow focus controls): Mod+WheelScrollLeft                 { focus-column-left; }
    // OLD (replaced by arrow movement controls): Mod+Ctrl+WheelScrollRight           { move-column-right; }
    // OLD (replaced by arrow movement controls): Mod+Ctrl+WheelScrollLeft            { move-column-left; }
    // OLD (replaced by arrow focus controls): Mod+Shift+WheelScrollDown           { focus-column-right; }
    // OLD (replaced by arrow focus controls): Mod+Shift+WheelScrollUp             { focus-column-left; }
    // OLD (replaced by arrow movement controls): Mod+Ctrl+Shift+WheelScrollDown      { move-column-right; }
    // OLD (replaced by arrow movement controls): Mod+Ctrl+Shift+WheelScrollUp        { move-column-left; }

}
