environment {
    KITTY_CONFIG_DIRECTORY "@HOME@/.config/serpantinum/kitty"
    SERPANTINUM_SESSION "1"
    STARSHIP_CONFIG "@HOME@/.config/serpantinum/starship-serpantinum.toml"
    NIXOS_OZONE_WL "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    LANG "pt_BR.UTF-8"
    QT_QPA_PLATFORM "wayland;xcb"
    MOZ_ENABLE_WAYLAND "1"
}
